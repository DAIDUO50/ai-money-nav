# ===== 站点信息 =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI导航
NEXT_PUBLIC_APP_GENERATOR=AI导航
NEXT_PUBLIC_APP_GENERATOR_URL=

# ===== Clerk 认证 =====
# 前往 https://clerk.com 注册并获取密钥
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_DEBUG=false
NEXT_PUBLIC_MANAGER_USER=your_manager_user_id

# ===== MongoDB =====
# 格式: mongodb+srv://用户名:密码@集群地址.mongodb.net/数据库名
# 或本地部署: mongodb://root:your_password@localhost:27017/aigotools?authSource=admin
MONGODB_URI=

# ===== 图片存储 =====
NEXT_PUBLIC_IMAGE_STORAGE=minio

# MinIO（推荐本地 Docker 部署）
MINIO_BASE=http://127.0.0.1:9000
MINIO_BUCKET=aigotools
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECERT_KEY=your_minio_secret_key

# AWS S3
S3_BASE=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_ACCESS_SECERT=

# 腾讯云 COS
COS_BASE=
COS_BUCKET=
COS_REGION=
COS_ACCESS_KEY=
COS_SECERT_KEY=

# ===== Crawler 爬虫网关 =====
CRAWLER_GATEWAY=http://localhost:13000
CRAWLER_AUTH_USER=admin
CRAWLER_AUTH_PASSWORD=your_crawler_password

# ===== Google Analytics（可选）=====
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=