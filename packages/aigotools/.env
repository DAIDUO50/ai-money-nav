# ===== 站点信息 =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI导航
NEXT_PUBLIC_APP_GENERATOR=AI导航
NEXT_PUBLIC_APP_GENERATOR_URL=

# ===== Clerk 认证（已禁用 - 包含 xxx 自动跳过）=====
# 如需启用：去 https://clerk.com 注册，替换下面的密钥
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_DEBUG=false
NEXT_PUBLIC_MANAGER_USER=user_xxx

# ===== MongoDB（留空则使用内置种子数据）=====
# 如需启用：https://mongodb.com 创建免费集群，获取连接串
# 格式: mongodb+srv://用户名:密码@集群地址.mongodb.net/数据库名
MONGODB_URI=

# ===== 图片存储（不配则上传功能不可用，不影响展示）=====
NEXT_PUBLIC_IMAGE_STORAGE=minio

# MinIO（推荐本地 Docker 部署）
MINIO_BASE=http://127.0.0.1:9000
MINIO_BUCKET=aigotools
MINIO_ENDPOINT=aigotools-minio
MINIO_PORT=9000
MINIO_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECERT_KEY=

# AWS S3
S3_BASE=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_ACCESS_SECERT=

# 腾讯云 COS
COS_BASE=
COS_BUCKET=
COS_REGION=
COS_ACCESS_KEY=
COS_SECERT_KEY=

# ===== Crawler 爬虫网关（不配则不影响前端展示）=====
CRAWLER_GATEWAY=
CRAWLER_AUTH_USER=
CRAWLER_AUTH_PASSWORD=

# ===== Google Analytics（可选）=====
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
