PORT=13000

# ===== Basic Auth =====
AUTH_USER=admin
AUTH_PASSWORD=your_crawler_password

# ===== MongoDB =====
MONGODB_URI=mongodb://root:your_mongo_password@localhost:27017/aigotools?authSource=admin

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=your_redis_password
REDIS_DB=0

# ===== 图片存储 =====
IMAGE_STORAGE=minio

# MinIO
MINIO_BASE=http://127.0.0.1:9000
MINIO_BUCKET=aigotools
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECERT_KEY=your_minio_secret_key

# AWS S3
S3_BASE=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_ACCESS_SECERT=

# 腾讯云 COS
COS_BASE=
COS_REGION=
COS_BUCKET=
COS_SECERT_ID=
COS_SECERT_KEY=

# ===== Jina AI（网页内容提取）=====
# 注册：https://jina.ai 获取 API Key
JINA_READ_BASE=https://r.jina.ai
JINA_API_KEY=your_jina_api_key

# ===== OpenAI（AI 描述生成）=====
# 注册：https://platform.openai.com 获取 API Key
OPENAI_BASEURL=https://api.openai.com/v1
OPENAI_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o